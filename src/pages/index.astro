---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MOTH — The Last Night</title>
    <meta
      name="description"
      content="Guide a moth through one last night with nothing but a light you carry."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <header class="visually-hidden">
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
    </header>
    <main>
      <h1 class="visually-hidden">MOTH — The Last Night</h1>
      <canvas
        id="scene"
        aria-label="A moth drifting through a dark garden at night, following a light you carry"
      ></canvas>
      <button id="mute" class="mute" type="button" aria-label="Mute">🔊</button>
      <button id="retry" class="retry" type="button">
        <span class="retry-icon" aria-hidden="true">&#8635;</span>
        <span class="retry-label">Retry</span>
      </button>
      <div id="ending" class="ending" aria-live="polite">
        <p class="ending-text">THE NIGHT REMEMBERS</p>
      </div>
      <div id="stageTitle" class="stage-title" aria-live="polite">
        <p class="stage-title-text"></p>
      </div>
      <div id="prologueTitle" class="prologue-title" aria-live="polite">
        <p class="prologue-title-text">MOTH — THE LAST NIGHT</p>
      </div>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
